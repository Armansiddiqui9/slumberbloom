# Environment template — copy to .env and fill in real values.
# Nothing is required to run the v1 demo; every variable below is optional or future-facing.

# --- Server (server/main.py, FastAPI on :8000) ---
# PORT=8000                      # dev server port (uvicorn --port)
# HOST=127.0.0.1

# --- Ollama (local AI: quests + photo judging), optional ---
# OLLAMA_ORIGINS=*               # needed only if the browser must reach localhost:11434
# OLLAMA_MODELS=llama3.2:3b,moondream

# --- Dev tools (demo time travel) — compiled out of production ---
# VITE_DEV_TOOLS=1               # enables the +8h/+24h/+49h time-travel buttons (v1 demo only)

# --- v1.1 (not built yet) ---
# DATABASE_URL=postgres://user:pass@localhost:5432/slumberbloom
# SB_SERVER_SIGNING_KEY=         # server key for signing Night Blocks (v1.1)
